/-- The `a`-th digit. -/
def dig (a : Fin 313) : Int × Int := digits[a.val]!

/-- Necessary condition for `61 + 6i` to divide `x + i y`:
`(x + i y) * (61 - 6i)` must be divisible by the norm `3757`. -/
def divB (x y : Int) : Bool := (61 * x + 6 * y) % 3757 == 0 && (61 * y - 6 * x) % 3757 == 0

/-- The finite check. For digits `A, B, C` (indices `a, b, c`) put
`z = A + i C - (1 + i) B`, so `z = (A.1 - C.2 - (B.1 - B.2)) + i (A.2 + C.1 - (B.1 + B.2))`.
Whenever `z` passes the divisibility test, `z = 0` (no carries), and then either the
solution is constant or an endpoint precedes the centre (peeling order).
All `313^3 = 30,664,297` triples are evaluated by compiled code (`native_decide`). -/
theorem certificate : ∀ a b c : Fin 313,
    divB ((dig a).1 - (dig c).2 - ((dig b).1 - (dig b).2))
         ((dig a).2 + (dig c).1 - ((dig b).1 + (dig b).2)) = true →
    ((dig a).1 - (dig c).2 - ((dig b).1 - (dig b).2) = 0 ∧
     (dig a).2 + (dig c).1 - ((dig b).1 + (dig b).2) = 0) ∧
    ((a = b ∧ c = b) ∨ a < b ∨ c < b) := by
  native_decide

/-- Every digit has modulus at most 30. -/
theorem digits_small : ∀ a : Fin 313, (dig a).1 * (dig a).1 + (dig a).2 * (dig a).2 ≤ 900 := by
  decide +kernel

